# Discord OAuth2 Credentials
# Obtain from https://discord.com/developers/applications -> OAuth2
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# JWT & Session Security
JWT_SECRET=super_secret_dissound_jwt_key_change_in_production_32chars

# Email Service for OTP Delivery (Optional - dev simulation mode provided if left empty)
# Can use Resend (RESEND_API_KEY) or standard SMTP
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dissound Verification <no-reply@dissound.app>"

# Dissound Bot API endpoint (if running backend bot API)
NEXT_PUBLIC_API_URL=http://localhost:3000
